def em(eid, fallback="⭐"):
    return f'<tg-emoji emoji-id="{eid}">{fallback}</tg-emoji>'

def stars_row():
    return f'{em(E_STAR1, "⭐")}{em(E_STAR2, "✨")}{em(E_STAR2, "✨")}{em(E_STAR3, "💫")}'

def arrows_row(n=6):
    return em(E_ARROW, "➡️") * n

# ============================================================
# УТИЛИТЫ
