def support_menu():
    kb = []
    for key, text, style, icon in SUPPORT_BUTTONS:
        kb.append([{"text": text, "callback_data": f"sup_{key}", "style": style, "icon_custom_emoji_id": icon}])
    kb.append([{"text": "Назад", "callback_data": "back_main", "style": "primary", "icon_custom_emoji_id": E_CROSS}])
    return {"inline_keyboard": kb}

def boost_menu():
    kb = []
    styles = ["success", "primary", "danger"]
    for i, (a, p) in enumerate(BOOST_PRICES):
        style = styles[i % 3]
        kb.append([{"text": f"{a} — {p}₽", "callback_data": f"boost_{a}", "style": style, "icon_custom_emoji_id": E_PRICE}])
    kb.append([{"text": "Назад", "callback_data": "back_main", "style": "primary", "icon_custom_emoji_id": E_CROSS}])
    return {"inline_keyboard": kb}

def back_button(cb="back_main"):
    return {"inline_keyboard": [[{"text": "Назад", "callback_data": cb, "style": "primary", "icon_custom_emoji_id": E_CROSS}]]}

def payment_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Я оплатил", "callback_data": f"paid_{pid}", "style": "success", "icon_custom_emoji_id": E_CHECK}],
        [{"text": "Не хочу оплачивать", "callback_data": f"cancel_{pid}", "style": "danger", "icon_custom_emoji_id": E_CROSS}],
    ]}

def owner_confirm_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Да, деньги пришли", "callback_data": f"owner_yes_{pid}", "style": "success", "icon_custom_emoji_id": E_CHECK}],
        [{"text": "Нет, отменить", "callback_data": f"owner_no_{pid}", "style": "danger", "icon_custom_emoji_id": E_CROSS}],
    ]}

def owner_done_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Заказ выполнен — Да", "callback_data": f"done_yes_{pid}", "style": "success", "icon_custom_emoji_id": E_CHECK}],
        [{"text": "Заказ выполнен — Нет", "callback_data": f"done_no_{pid}", "style": "danger", "icon_custom_emoji_id": E_CROSS}],
    ]}

def group_join_menu(pid):
    return {"inline_keyboard": [
        [{"text": "Я участвую в сопровождении", "callback_data": f"join_{pid}", "style": "success", "icon_custom_emoji_id": E_USER}]
    ]}

# ============================================================
# ФУНКЦИЯ ФОРМИРОВАНИЯ ТЕКСТА ЗАКАЗА В ГРУППЕ
# (всегда с описанием)
# ============================================================

def build_group_text(pid):
    """Собирает полный текст заказа в группу: с описанием и участниками"""
    o = orders.get(pid, {})
    gm = group_messages.get(pid, {})
    parts = gm.get("parts", [])
    total = len(parts)
    buyer = o.get("username", "—")
    pubg = o.get("pubg_id", "—")
    item = o.get("item_name", "—")
    price = o.get("price", "—")
    
    # Описание (полное, с деталями)
    desc = SUPPORT_DESCRIPTIONS.get(o.get("item_key"), "") if o.get("type") == "support" else ""
    
    text = (
        f'{em(E_BOX, "📦")} <b>НОВЫЙ ЗАКАЗ В СОПРОВОЖДЕНИЕ</b>\n\n'
        f'{em(E_USER, "👤")} Купил: @{buyer}\n'
        f'{em(E_USER, "🆔")} PUBG ID: <code>{pubg}</code>\n\n'
        f'{em(E_BOX, "📦")} Товар: <b>{item}</b>\n'
        f'{em(E_PRICE, "💵")} Цена: {price}₽\n\n'
    )
    
    if desc:
        text += f'{em(E_DIAMOND, "💎")} <b>Описание:</b>\n{desc}\n\n'
    
    text += f'{em(E_USER, "👥")} Участвуют: {", ".join(parts)} ({total}/{MAX_PARTICIPANTS})'
    return text

# ============================================================
# ГЛАВНОЕ МЕНЮ
# ============================================================

def send_main_menu(chat_id):
    global PHOTO_FILE_ID
    clear_last_message(chat_id)
    photo = PHOTO_FILE_ID or PHOTO_URL
    r = send_photo_safe(chat_id, photo, caption=MAIN_CAPTION, reply_markup=main_menu())
    if r.get("ok"):
        if not PHOTO_FILE_ID:
            try:
                PHOTO_FILE_ID = r["result"]["photo"][-1]["file_id"]
                logger.info(f'💾 PHOTO_FILE_ID = "{PHOTO_FILE_ID}"')
            except: pass
        remember_message(chat_id, r["result"]["message_id"])
    else:
        r2 = send_safe(chat_id, MAIN_CAPTION, main_menu())
        if r2.get("ok"):
            remember_message(chat_id, r2["result"]["message_id"])
    return r

def send_replacing(chat_id, text, reply_markup=None):
    clear_last_message(chat_id)
    r = send_safe(chat_id, text, reply_markup)
    if r.get("ok"):
        remember_message(chat_id, r["result"]["message_id"])
    return r

# ============================================================
# ЛОГИКА ПОКУПКИ
# ============================================================

def start_purchase(chat_id, itype, ikey, iname, price):
    clear_last_message(chat_id)
    pid = gen_order_id()
    orders[pid] = {"user_id": chat_id, "type": itype, "item_key": ikey,
                   "item_name": iname, "price": price, "status": "awaiting_payment"}
    logger.info(f"🛒 {pid}: {iname} — {price}₽")
    text = (
        f'{em(E_BOX, "📦")} <b>ОПЛАТА ЗАКАЗА</b>\n\n'
        f'{em(E_USER, "👤")} Товар: <b>{iname}</b>\n'
        f'{em(E_PRICE, "💵")} Сумма: <b>{price}₽</b>\n\n'
        f'{em(E_DIAMOND, "💎")} <b>Реквизиты:</b>\n'
        f'{em(E_MONEY, "💳")} Карта Сбер: <code>{PAY_CARD}</code>\n'
        f'{em(E_MONEY, "📱")} Телефон Сбер: <code>{PAY_PHONE}</code>\n\n'
        f'{em(E_INFO, "ℹ️")} После оплаты нажмите «Я оплатил»'
    )
    r = send_safe(chat_id, text, payment_menu(pid))
    if r.get("ok"):
        remember_message(chat_id, r["result"]["message_id"])
    return pid

def process_paid(chat_id, cb_id, pid):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, f'{em(E_CROSS, "❌")} Заказ не найден', True)
        return
    if o["status"] != "awaiting_payment":
        answer_callback(cb_id, f'{em(E_TIME, "⏳")} Уже обработан', True)
        return
    
    o["status"] = "awaiting_owner_confirm"
    o["username"] = get_username(chat_id)
    logger.info(f'💰 {pid}: {chat_id} нажал Я оплатил')
    
    owner_text = (
        f'{em(E_MONEY, "💰")} <b>ПОДТВЕРЖДЕНИЕ ОПЛАТЫ</b>\n\n'
        f'{em(E_USER, "👤")} Покупатель: @{o["username"]}\n'
        f'{em(E_BOX, "📦")} Товар: {o["item_name"]}\n'
        f'{em(E_PRICE, "💵")} Сумма: {o["price"]}₽\n\n'
        f'{em(E_INFO, "ℹ️")} Пришли ли вам деньги?'
    )
    send_safe(OWNER_ID, owner_text, owner_confirm_menu(pid))
    answer_callback(cb_id, f'{em(E_CHECK, "✅")} Отправлено админу')
    send_replacing(chat_id, f'{em(E_TIME, "⏳")} Ожидайте подтверждения...')

def owner_confirm(cb_id, pid, yes):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, f'{em(E_CROSS, "❌")} Не найден', True)
        return
    if yes:
        o["status"] = "awaiting_info"
        logger.info(f'✅ {pid}: админ подтвердил')
        
        if o["type"] == "boost":
            send_safe(o["user_id"],
                f'{em(E_CHECK, "✅")} <b>Оплата подтверждена!</b>\n\n'
                f'{em(E_INFO, "ℹ️")} Ожидайте QR-код от админа. Зайдите в игру и вставьте его.\n\n'
                f'{em(E_TIME, "⏳")} Максимум 20 минут.')
        else:
            send_safe(o["user_id"],
                f'{em(E_CHECK, "✅")} <b>Заказ оплачен!</b>\n\n'
                f'{em(E_USER, "🆔")} Введите ваш PUBG ID (только цифры, до 25):')
        
        answer_callback(cb_id, f'{em(E_CHECK, "✅")} Подтверждено')
    else:
        o["status"] = "rejected"
        logger.info(f'❌ {pid}: админ отменил')
        send_safe(o["user_id"], f'{em(E_CROSS, "❌")} Заказ отменён.')
        answer_callback(cb_id, f'{em(E_CROSS, "❌")} Отменено')

def process_pubg_id(chat_id, pid_text):
    uid = str(chat_id)
    o = None
    key = None
    for k, v in orders.items():
        if str(v.get("user_id")) == uid and v.get("status") == "awaiting_info":
            o = v
            key = k
            break
    if not o:
        return False
    
    o["pubg_id"] = pid_text
    o["status"] = "in_group"
    uname = o.get("username", "user")
    logger.info(f'🆔 {key}: PUBG {pid_text}')
    
    # Инициализируем участников — покупатель уже первый
    group_messages[key] = {"message_id": None, "parts": [f"@{uname}"]}
    
    # Собираем полный текст с описанием
    text = build_group_text(key)
    r = send_safe(GROUP_ID, text, group_join_menu(key))
    if r.get("ok"):
        group_messages[key]["message_id"] = r["result"]["message_id"]
        logger.info(f'✅ {key}: в группе ({len(group_messages[key]["parts"])}/{MAX_PARTICIPANTS})')
    
    send_safe(chat_id,
        f'{em(E_CHECK, "✅")} <b>Хорошо!</b>\n\n'
        f'{em(E_INFO, "ℹ️")} Ждите в игре максимум 20 минут.'
    )
    return True

def process_join(chat_id, cb_id, pid):
    if pid not in group_messages:
        answer_callback(cb_id, f'{em(E_CROSS, "❌")} Не найден', True)
        return
    gm = group_messages[pid]
    uname = f"@{get_username(chat_id)}"
    
    if uname in gm["parts"]:
        answer_callback(cb_id, f'{em(E_TIME, "⚠️")} Уже участвуете', True)
        return
    # максимум 4 человека ВСЕГО (покупатель + 3)
    if len(gm["parts"]) >= MAX_PARTICIPANTS:
        answer_callback(cb_id, f'{em(E_CROSS, "❌")} Мест нет (макс {MAX_PARTICIPANTS})', True)
        return
    
    gm["parts"].append(uname)
    answer_callback(cb_id, f'{em(E_CHECK, "✅")} ({len(gm["parts"])}/{MAX_PARTICIPANTS})')
    
    # Полный текст заново (с описанием)
    nt = build_group_text(pid)
    markup = None if len(gm["parts"]) >= MAX_PARTICIPANTS else group_join_menu(pid)
    edit_safe(GROUP_ID, gm["message_id"], nt, markup)

def owner_send_qr(file_id, caption=""):
    cnt = 0
    for pid, o in list(orders.items()):
        if o.get("status") in ("in_group", "awaiting_info", "awaiting_qr"):
            send_photo_safe(o["user_id"], file_id,
                caption=(
                    f'{em(E_INFO, "ℹ️")} <b>Ваш QR-код!</b>\n\n'
                    f'{em(E_TIME, "⏳")} 5 минут чтобы использовать, иначе заново.\n\n'
                    + (caption or "")
                ))
            o["status"] = "awaiting_done"
            send_safe(OWNER_ID, f'{em(E_CHECK, "✅")} QR → {pid}', owner_done_menu(pid))
            cnt += 1
    if cnt == 0:
        send_safe(OWNER_ID, f'{em(E_CROSS, "⚠️")} Нет заказов для QR')

def owner_done(cb_id, pid, yes):
    o = orders.get(pid)
    if not o:
        answer_callback(cb_id, f'{em(E_CROSS, "❌")} Не найден', True)
        return
    if yes:
        o["status"] = "completed"
        buyer_id = o["user_id"]
        send_safe(buyer_id,
            f'{em(E_CHECK, "✅")} <b>Заказ выполнен!</b>\n\n'
            f'{em(E_HEART, "❤️‍🔥")} Напишите пожалуйста отзыв — просто отправьте сообщение с отзывом.'
        )
        review_pending[str(buyer_id)] = True
        answer_callback(cb_id, f'{em(E_CHECK, "✅")} Закрыт')
        send_safe(OWNER_ID, f'{em(E_CHECK, "✅")} Заказ {pid} закрыт')
    else:
        o["status"] = "awaiting_qr"
        send_safe(o["user_id"], f'{em(E_INFO, "ℹ️")} Админ пришлёт новый QR.')
        answer_callback(cb_id, f'{em(E_TIME, "⚠️")} Ждём QR')

def process_review(chat_id, text):
    uid = str(chat_id)
    if uid not in review_pending:
        return False
    
    del review_pending[uid]
    uname = get_username(chat_id)
    full_name = get_full_name(chat_id)
    
    review_text = (
        f'{em(E_USER, "👤")} <b>Отзыв от</b> @{uname} ({full_name})\n\n'
        f'{em(E_HEART, "❤️‍🔥")} <b>Отзыв:</b>\n{text}\n\n'
        f'{em(E_DIAMOND, "💎")} <i>Kranzayy | Metro Shop</i>'
    )
    
    r = send_safe(REVIEWS_CHANNEL, review_text)
    if r.get("ok"):
        logger.info(f'✅ Отзыв от {uname} отправлен')
        send_safe(chat_id, f'{em(E_CHECK, "✅")} Спасибо за отзыв!')
    else:
        logger.error(f'❌ Не удалось: {r}')
        send_safe(chat_id, f'{em(E_CROSS, "❌")} Ошибка отправки.')
    return True

# ============================================================
# ОБРАБОТКА
# ============================================================

def handle_update(u):
    try:
        if "message" in u:
            m = u["message"]
            chat_id = m["chat"]["id"]
            text = m.get("text", "")
            photo = m.get("photo")
            
            if photo and chat_id == OWNER_ID:
                owner_send_qr(photo[-1]["file_id"], m.get("caption", ""))
                return
            
            if text == "/start":
                logger.info(f'🖱 /start от {chat_id}')
                send_main_menu(chat_id)
                return
            
            uid = str(chat_id)
            if uid in review_pending and text and not text.startswith("/"):
                process_review(chat_id, text)
                return
            
            if text and text.isdigit() and len(text) <= 25:
                if process_pubg_id(chat_id, text):
                    return
        
        elif "callback_query" in u:
            cb = u["callback_query"]
            chat_id = cb["message"]["chat"]["id"]
            data = cb["data"]
            cb_id = cb["id"]
            logger.info(f'🖱 {data} от {chat_id}')
            
            if data == "back_main":
                answer_callback(cb_id)
                send_main_menu(chat_id)
                return
            
            if data == "menu_support":
                answer_callback(cb_id)
                send_replacing(chat_id,
                    f'{em(E_DIAMOND, "💎")} <b>Выберите подходящее сопровождение:</b>',
                    support_menu())
                return
            
            if data.startswith("sup_"):
                key = data.replace("sup_", "")
                if key in SUPPORT_DESCRIPTIONS:
                    answer_callback(cb_id)
                    kb = {"inline_keyboard": [
                        [{"text": "Купить", "callback_data": f"buysup_{key}", "style": "success", "icon_custom_emoji_id": E_CHECK}],
                        [{"text": "Назад", "callback_data": "menu_support", "style": "primary", "icon_custom_emoji_id": E_CROSS}]
                    ]}
                    send_replacing(chat_id, SUPPORT_DESCRIPTIONS[key], kb)
                return
            
            if data.startswith("buysup_"):
                key = data.replace("buysup_", "")
                if key in SUPPORT_PRICES:
                    answer_callback(cb_id)
                    start_purchase(chat_id, "support", key, SUPPORT_NAMES[key], SUPPORT_PRICES[key])
                return
            
            if data == "menu_kits":
                answer_callback(cb_id)
                send_replacing(chat_id, KITS_TEXT, back_button())
                return
            
            if data == "menu_loot":
                answer_callback(cb_id)
                send_replacing(chat_id, LOOT_TEXT, back_button())
                return
            
            if data == "menu_boost":
                answer_callback(cb_id)
                bt = f'{em(BTN_BOOST_PRICE, "💎")} <b>ПРАЙС ЧЕРЕЗ QR</b>\n\n'
                for a, p in BOOST_PRICES:
                    bt += f'{a} — {p}₽\n'
                send_replacing(chat_id, bt, boost_menu())
                return
            
            if data.startswith("boost_"):
                a = data.replace("boost_", "")
                for amt, pr in BOOST_PRICES:
                    if amt == a:
                        answer_callback(cb_id)
                        start_purchase(chat_id, "boost", a, f"БУСТ {a}", pr)
                        return
                return
            
            if data.startswith("paid_"):
                process_paid(chat_id, cb_id, data.replace("paid_", ""))
                return
            
            if data.startswith("cancel_"):
                pid = data.replace("cancel_", "")
                if pid in orders:
                    orders[pid]["status"] = "cancelled"
                answer_callback(cb_id, f'{em(E_CROSS, "❌")} Отменено')
                send_replacing(chat_id, f'{em(E_CROSS, "❌")} Отменено', main_menu())
                return
            
            if data.startswith("owner_yes_"):
                owner_confirm(cb_id, data.replace("owner_yes_", ""), True)
                return
            if data.startswith("owner_no_"):
                owner_confirm(cb_id, data.replace("owner_no_", ""), False)
                return
            if data.startswith("done_yes_"):
                owner_done(cb_id, data.replace("done_yes_", ""), True)
                return
            if data.startswith("done_no_"):
                owner_done(cb_id, data.replace("done_no_", ""), False)
                return
            if data.startswith("join_"):
                process_join(chat_id, cb_id, data.replace("join_", ""))
                return
            
            answer_callback(cb_id, f'{em(E_INFO, "❓")}')
    
    except Exception as e:
        logger.error(f'💥 handle_update: {e}')
        logger.error(traceback.format_exc())

# ============================================================
# УВЕДОМЛЕНИЕ
# ============================================================

def notify_startup(bot_username):
    try:
        now = datetime.datetime.now().strftime("%d.%m.%Y %H:%M:%S")
        text = (
            f'{em(E_CHECK, "✅")} <b>БОТ УСПЕШНО ЗАПУЩЕН!</b>\n\n'
            f'{em(E_USER, "🤖")} Бот: @{bot_username}\n'
            f'{em(E_TIME, "🕐")} Время: {now}\n'
            f'{em(E_DIAMOND, "📊")} Режим: поллинг\n'
            f'{em(E_USER, "👥")} Группа: <code>{GROUP_ID}</code>\n'
            f'{em(E_USER, "⭐")} Канал отзывов: <code>{REVIEWS_CHANNEL}</code>\n'
            f'{em(E_USER, "👤")} Владелец: <code>{OWNER_ID}</code>\n'
            f'{em(E_USER, "👥")} Макс участников: {MAX_PARTICIPANTS}\n\n'
            f'<b>Готов принимать заказы!</b>'
        )
        r = send_safe(OWNER_ID, text)
        if r.get("ok"):
            logger.info("✅ Уведомление о запуске отправлено")
            return True
        return False
    except Exception as e:
        logger.error(f'💥 notify_startup: {e}')
        return False

# ============================================================
# ЗАПУСК
# ============================================================

def main():
    logger.info("=" * 60)
    logger.info("🚀 KRANZAYY BOT — ЗАПУСК")
    logger.info("=" * 60)
    
    if not check_internet():
        logger.warning("⚠️ Нет доступа к api.telegram.org — ждём...")
        while not check_internet():
            time.sleep(10)
            logger.info("🔄 Проверка...")
    logger.info("✅ Интернет доступен")
    
    me = api_request("getMe", {})
    if not me.get("ok"):
        logger.error(f'❌ Бот не отвечает: {me}')
        return
    bot_username = me["result"].get("username", "unknown")
    logger.info(f'✅ Бот найден: @{bot_username}')
    
    api_request("deleteWebhook", {"drop_pending_updates": True})
    notify_startup(bot_username)
    
    offset = None
    reconnect_delay = RECONNECT_MIN
    consecutive_errors = 0
    
    logger.info("=" * 60)
    logger.info("🚀 ПОЛЛИНГ ЗАПУЩЕН")
    logger.info("=" * 60)
    
    while True:
        try:
            r = requests.get(f"{BASE_URL}/getUpdates",
                           params={"timeout": 30, "offset": offset},
                           timeout=35).json()
            if r.get("ok"):
                if consecutive_errors > 0:
                    logger.info("✅ Соединение восстановлено")
                consecutive_errors = 0
                reconnect_delay = RECONNECT_MIN
                for upd in r.get("result", []):
                    handle_update(upd)
                    offset = upd["update_id"] + 1
            else:
                logger.error(f'❌ getUpdates: {r}')
            time.sleep(0.3)
        except requests.exceptions.Timeout:
            consecutive_errors += 1
            time.sleep(2)
        except requests.exceptions.ConnectionError:
            consecutive_errors += 1
            wait = min(reconnect_delay, RECONNECT_MAX)
            logger.info(f'⏳ Переподключение через {wait} сек...')
            time.sleep(wait)
            reconnect_delay = min(reconnect_delay * 2, RECONNECT_MAX)
            continue
        except KeyboardInterrupt:
            logger.info("⏹ Остановлен")
            break
        except Exception as e:
            consecutive_errors += 1
            logger.error(f'💥 main: {e}')
            time.sleep(5)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        logger.info("⏹ Остановлен")
    except Exception as e:
        logger.error(f'💥 Фатальная: {e}')
        logger.error(traceback.format_exc())
